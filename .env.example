# ---------------------------------------------------------------------------
# Kopiraj u .env i popuni vrednosti:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Aplikacija ------------------------------------------------------------
# Javni URL aplikacije. Koristi se za magic-link mejlove, deljenje pozivnica,
# QR kodove i Open Graph metapodatke.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Brendiranje -----------------------------------------------------------
# Ceo brend je konfigurabilan (naziv, domen, kontakt) - vidi src/config/brand.ts
NEXT_PUBLIC_BRAND_NAME="Pozivnica"
NEXT_PUBLIC_BRAND_DOMAIN="pozivnica.rs"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="podrska@pozivnica.rs"

# --- Baza podataka ---------------------------------------------------------
# Podrazumevano odgovara docker-compose.yml servisu "db".
DATABASE_URL="postgresql://pozivnica:pozivnica@localhost:5432/pozivnica"

# Zasebna baza za integracione testove (npm run test:integration).
# Ako nije postavljena, integracioni testovi se preskaču.
TEST_DATABASE_URL="postgresql://pozivnica:pozivnica@localhost:5432/pozivnica_test"

# --- Autentifikacija (Auth.js) ---------------------------------------------
# Obavezno u produkciji. Generiši sa: openssl rand -base64 32
AUTH_SECRET="promeni-me-u-nasumicnu-vrednost-od-najmanje-32-znaka"
# Auth.js v5 u produkciji zahteva tačan URL iza proksija:
AUTH_TRUST_HOST="true"

# Opciona Google prijava. Ostavi prazno da se dugme ne prikazuje.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email adapter ---------------------------------------------------------
# console = ispisuje mejlove u terminal (development, ne šalje ništa)
# resend  = šalje preko Resend API-ja (zahteva RESEND_API_KEY)
EMAIL_DRIVER="console"
EMAIL_FROM="Pozivnica <noreply@pozivnica.rs>"
RESEND_API_KEY=""

# --- Storage adapter -------------------------------------------------------
# local = čuva fajlove u public/uploads (samo za development)
# s3    = bilo koji S3-kompatibilan servis (AWS S3, MinIO, Cloudflare R2...)
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pozivnica-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Javni bazni URL preko kog se serviraju otpremljene fotografije.
S3_PUBLIC_URL="http://localhost:9000/pozivnica-media"
# Hostovi sa kojih next/image sme da učitava slike (zarezom razdvojeno).
NEXT_PUBLIC_MEDIA_HOSTS=""

# --- Payment adapter -------------------------------------------------------
# dev = lažni provajder; narudžbina se označava kao plaćena ručno iz admin panela.
#       Blokiran je u produkciji (NODE_ENV=production) da se nikad ne prikaže
#       lažno uspešno plaćanje.
PAYMENT_DRIVER="dev"
PAYMENT_CURRENCY="RSD"
# Tajna za proveru potpisa webhooka payment provajdera.
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

# --- Rate limiting ---------------------------------------------------------
# memory = in-process brojači (dovoljno za development i jednu instancu)
RATE_LIMIT_DRIVER="memory"

# --- Sistem ----------------------------------------------------------------
# Retencija: broj dana posle datuma događaja nakon kojih se podaci gostiju
# anonimizuju (0 = isključeno).
DATA_RETENTION_DAYS="365"
